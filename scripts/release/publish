#!/usr/bin/env bash
set -eou pipefail

VERSION=$1
REGISTRY="ghcr.io/portfolio-solver-platform"
IMAGE_NAME="parasol"
GIT_SHA=$(git rev-parse --short HEAD)

IMAGE_BASE_MAIN="$REGISTRY/$IMAGE_NAME"
CACHE_URI="$IMAGE_BASE_MAIN:buildcache"
echo "Building and pushing main Docker image ($IMAGE_BASE_MAIN)..."
docker buildx build --push \
  --cache-from="type=registry,ref=$CACHE_URI" \
  -t "$IMAGE_BASE_MAIN:$VERSION" \
  -t "$IMAGE_BASE_MAIN:latest" \
  -t "$IMAGE_BASE_MAIN:$GIT_SHA" \
  .

IMAGE_BASE_ELIGIBLE="$REGISTRY/$IMAGE_NAME-challenge-eligible"
echo "Building and pushing eligible challenge Docker image ($IMAGE_BASE_ELIGIBLE)..."
docker buildx build --push \
  --build-arg PARASOL_TEMPLATE=parasol-challenge-eligible.msc.template \
  --cache-from="type=registry,ref=$CACHE_URI" \
  -t "$IMAGE_BASE_ELIGIBLE:$VERSION" \
  -t "$IMAGE_BASE_ELIGIBLE:latest" \
  -t "$IMAGE_BASE_ELIGIBLE:$GIT_SHA" \
  .

IMAGE_BASE_INELIGIBLE="$REGISTRY/$IMAGE_NAME-challenge-ineligible"
echo "Building and pushing ineligible challenge Docker image ($IMAGE_BASE_INELIGIBLE)..."
docker buildx build --push \
  --build-arg PARASOL_TEMPLATE=parasol-challenge-ineligible.msc.template \
  --cache-from="type=registry,ref=$CACHE_URI" \
  -t "$IMAGE_BASE_INELIGIBLE:$VERSION" \
  -t "$IMAGE_BASE_INELIGIBLE:latest" \
  -t "$IMAGE_BASE_INELIGIBLE:$GIT_SHA" \
  .
